-- 🔥 ОПТИМИЗИРОВАННЫЙ СБОР БЕЗ ЛАГОВ
local function ultraCollect()
    if not isFarming then return end
    
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Быстрый поиск ВСЕХ предметов
    for _, item in pairs(workspace:GetDescendants()) do
        if not isFarming then break end
        
        -- Проверяем только важные свойства (меньше лагов)
        if item:IsA("Part") and item.Parent then
            local distance = (root.Position - item.Position).Magnitude
            
            -- Большой радиус сбора
            if distance < 100 then
                -- Мгновенный сбор через все возможные методы
                local prompt = item:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    for i = 1, 3 do  -- Многократный сбор
                        fireproximityprompt(prompt)
                    end
                    itemsCollected = itemsCollected + 1
                    counter.Text = "Items: " .. itemsCollected
                end
                
                local clickDetector = item:FindFirstChildOfClass("ClickDetector")
                if clickDetector then
                    for i = 1, 3 do
                        fireclickdetector(clickDetector)
                    end
                    itemsCollected = itemsCollected + 1
                    counter.Text = "Items: " .. itemsCollected
                end
                
                -- Автоперемещение предмета к игроку
                if distance < 50 then
                    item.CFrame = root.CFrame + Vector3.new(0, 5, 0)
                end
            end
        end
    end
end

-- 🎯 АВТО-ТЕЛЕПОРТАЦИЯ ДЛЯ МАКСИМАЛЬНОЙ ЭФФЕКТИВНОСТИ
local function teleportToHotspots()
    if not isFarming then return end
    
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Телепортация по точкам спавна предметов
    local hotspots = {
        Vector3.new(0, 10, 0),      -- Центр
        Vector3.new(50, 10, 0),     -- Право
        Vector3.new(-50, 10, 0),    -- Лево
        Vector3.new(0, 10, 50),     -- Перед
        Vector3.new(0, 10, -50),    -- Зад
        Vector3.new(30, 10, 30),    -- Диагональ
        Vector3.new(-30, 10, -30)   -- Диагональ
    }
    
    for _, pos in pairs(hotspots) do
        if not isFarming then break end
        root.CFrame = CFrame.new(pos)
        wait(0.5)  -- Ждем появления предметов
        ultraCollect()  -- Собираем на этой точке
    end
end

-- ⚡ СУПЕР-БЫСТРЫЙ РЕЖИМ
local function superFastMode()
    if not isFarming then return end
    
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        -- Увеличиваем скорость для быстрого перемещения
        humanoid.WalkSpeed = 50
    end
    
    -- Постоянный сбор + телепортация
    while isFarming do
        ultraCollect()
        teleportToHotspots()
        wait(0.1)  -- Минимальная задержка
    end
end

-- 🚀 ЗАПУСК СУПЕР-ФАРМА
local function startUltraFarm()
    isFarming = true
    itemsCollected = 0
    
    button.Text = "🔴 STOP ULTRA FARM"
    button.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    status.Text = "Status: 🟢 ULTRA FARMING"
    counter.Text = "Items: 0"
    
    -- Запускаем в отдельном потоке чтобы не лагало
    connection = RunService.Heartbeat:Connect(function()
        if isFarming then
            pcall(superFastMode)
        end
    end)
end

-- ⏹️ ОСТАНОВКА
local function stopUltraFarm()
    isFarming = false
    
    if connection then
        connection:Disconnect()
    end
    
    -- Возвращаем нормальную скорость
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
        end
    end
    
    button.Text = "🚀 START ULTRA FARM"
    button.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    status.Text = "Status: ❌ OFF"
end

-- Кнопка управления
button.MouseButton1Click:Connect(function()
    if isFarming then
        stopUltraFarm()
    else
        startUltraFarm()
    end
end)

print("⚡ Ultra Durability Farm loaded! Ready for fast farming!")
